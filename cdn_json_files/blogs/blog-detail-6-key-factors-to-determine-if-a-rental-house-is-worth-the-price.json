height=\"auto\" style=\"border-width: 1.06667px; border-color: rgb(0, 0, 0); padding: 7.97px 0px; width: 384px; height: auto; vertical-align: top;\"><p data-header=\"0\" class=\"zw-paragraph heading0\" data-textformat=\"{\" fgc\":\"rgb(0,=\"\" 0,=\"\" 0)\",\"size\":\"10.50\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" style=\"margin-right: 0px; margin-bottom: 12pt; margin-left: 0px; line-height: 1.2;\"><span style=\"font-family: Roboto; font-size: 10.5pt; vertical-align: baseline;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;High Supply</span></p></td><td class=\"zw-td\" col-index=\"1\" data-cell-height=\"auto\" style=\"border-width: 1.06667px; border-color: rgb(0, 0, 0); padding: 7.97px 0px; width: 290.016px; height: auto; vertical-align: top;\"><p data-header=\"0\" class=\"zw-paragraph heading0\" data-textformat=\"{\" fgc\":\"rgb(0,=\"\" 0,=\"\" 0)\",\"size\":\"10.50\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" style=\"margin-right: 0px; margin-bottom: 12pt; margin-left: 0px; line-height: 1.2;\"><span style=\"font-family: Roboto; font-size: 10.5pt; vertical-align: baseline;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Prices Decrease</span></p></td></tr></tbody></table><p style=\"margin: 18pt 0px 6pt; line-height: 1.6;\"><b><span style=\"vertical-align: baseline;\">Regulatory Environment</span><span data-range-char-type=\"start\" data-bookmark-info=\"{\" name\":\"_toccz43wigb5ugm\",\"id\":\"toc_1lxitdlts6it\",\"type\":\"bookmark\",\"render_type\":\"inline\",\"geo_transformation\":{\"translation\":{\"x\":false,\"y\":false},\"scaling\":{\"x\":false,\"y\":false},\"rotation\":false}}\"=\"\" data-bookmark-id=\"toc_1lxitdlts6it\">&nbsp;</span><span data-range-char-type=\"end\" data-bookmark-info=\"{\" name\":\"_toccz43wigb5ugm\",\"id\":\"toc_1lxitdlts6it\",\"type\":\"bookmark\"}\"=\"\" data-bookmark-id=\"toc_1lxitdlts6it\">&nbsp;</span></b></p><p data-textformat=\"{\" fgc\":\"rgb(0,=\"\" 0,=\"\" 0)\",\"size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data_styles=\"{\" data-line-height=\"1.2\" class=\"zw-paragraph\" style=\"margin-right: 0px; margin-bottom: 12pt; margin-left: 0px; line-height: 1.2;\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\">Government policies on housing can also affect the rental prices. Change in tenant rights or taxation of landlords may change the amount that the landlord charges for rent.</span></p><p data-header=\"2\" class=\"zw-paragraph heading2\" data-margin-bottom=\"6pt\" data-margin-top=\"18pt\" data-hd-info=\"2\" data-line-height=\"1.6\" style=\"margin: 18pt 0px 6pt; line-height: 1.6;\"><b><span style=\"vertical-align: baseline;\">Rental Yield Calculations</span><span data-range-char-type=\"start\" data-bookmark-info=\"{\" name\":\"_tocxqf8131gqvz7\",\"id\":\"toc_7gveqekmcvym\",\"type\":\"bookmark\",\"render_type\":\"inline\",\"geo_transformation\":{\"translation\":{\"x\":false,\"y\":false},\"scaling\":{\"x\":false,\"y\":false},\"rotation\":false}}\"=\"\" data-bookmark-id=\"toc_7gveqekmcvym\">&nbsp;</span><span data-range-char-type=\"end\" data-bookmark-info=\"{\" name\":\"_tocxqf8131gqvz7\",\"id\":\"toc_7gveqekmcvym\",\"type\":\"bookmark\"}\"=\"\" data-bookmark-id=\"toc_7gveqekmcvym\">&nbsp;</span></b></p><p data-header=\"0\" class=\"zw-paragraph heading0\" data-textformat=\"{\" fgc\":\"rgb(0,=\"\" 0,=\"\" 0)\",\"size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" style=\"margin-right: 0px; margin-bottom: 12pt; margin-left: 0px; line-height: 1.2;\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\"><a href=\"https://www.kots.world/blog/rental-yield-in-india-unlocking-the-profit-potential\" target=\"_blank\"><span style=\"color: rgb(0, 0, 255); font-weight: bold;\">Rental yields</span> </a>calculation is very important to both landlords and tenants.</span></p><p data-header=\"2\" class=\"zw-paragraph heading2\" data-margin-bottom=\"6pt\" data-margin-top=\"18pt\" data-hd-info=\"2\" data-line-height=\"1.6\" style=\"margin: 18pt 0px 6pt; line-height: 1.6;\"><b><span style=\"vertical-align: baseline;\">Gross Yield vs. Net Yield</span><span data-range-char-type=\"start\" data-bookmark-info=\"{\" name\":\"_toc2oizpzzu48e9\",\"id\":\"toc_73idzjvvo2kj\",\"type\":\"bookmark\",\"render_type\":\"inline\",\"geo_transformation\":{\"translation\":{\"x\":false,\"y\":false},\"scaling\":{\"x\":false,\"y\":false},\"rotation\":false}}\"=\"\" data-bookmark-id=\"toc_73idzjvvo2kj\">&nbsp;</span><span data-range-char-type=\"end\" data-bookmark-info=\"{\" name\":\"_toc2oizpzzu48e9\",\"id\":\"toc_73idzjvvo2kj\",\"type\":\"bookmark\"}\"=\"\" data-bookmark-id=\"toc_73idzjvvo2kj\">&nbsp;</span></b></p><ul data-list-id=\"71620441\" data-list-format=\"{\" level5\":{\"type\":8,\"startswith\":1},\"level4\":{\"type\":7,\"startswith\":1},\"level7\":{\"type\":7,\"startswith\":1},\"level6\":{\"type\":6,\"startswith\":1},\"level8\":{\"type\":8,\"startswith\":1},\"level1\":{\"type\":7,\"startswith\":1},\"level0\":{\"type\":6,\"startswith\":1},\"level3\":{\"type\":6,\"startswith\":1},\"level2\":{\"type\":8,\"startswith\":1}}\"=\"\" data-spl-bullet-format=\"{}\" style=\"list-style-position: initial; list-style-image: initial;\"><li><p class=\"zw-list zw-paragraph heading0\" data-header=\"0\" data-textformat=\"{\" size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-left=\"0.5in\" data-text-indent=\"-0.25in\" data-margin-bottom=\"6pt\" data-margin-top=\"6pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" data-list-id=\"71620441\" data-list-info=\"{\" id\":\"71620441\",\"l\":0}\"=\"\" style=\"margin: 6pt 0px; line-height: 1.2; direction: ltr;\"><span style=\"vertical-align: baseline;\">Gross Yield</span><span style=\"vertical-align: baseline;\">: </span><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\">This is the annual rent divided by the purchase price of the property.</span></p></li><li><p class=\"zw-list zw-paragraph heading0\" data-header=\"0\" data-textformat=\"{\" size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-left=\"0.5in\" data-text-indent=\"-0.25in\" data-margin-bottom=\"6pt\" data-margin-top=\"6pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" data-list-id=\"71620441\" data-list-info=\"{\" id\":\"71620441\",\"l\":0}\"=\"\" style=\"margin: 6pt 0px; line-height: 1.2; direction: ltr;\"><span style=\"vertical-align: baseline;\">Net Yield</span><span style=\"vertical-align: baseline;\">: </span><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\">This factor includes overheads like maintenance cost and management fee paid from the gross income.</span></p></li></ul><p data-textformat=\"{\" fgc\":\"rgb(0,=\"\" 0,=\"\" 0)\",\"size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data_styles=\"{\" data-line-height=\"1.2\" class=\"zw-paragraph\" style=\"margin-right: 0px; margin-bottom: 12pt; margin-left: 0px; line-height: 1.2;\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\"><b>For example:</b></span></p><ul data-list-id=\"77757269\" data-list-format=\"{\" level5\":{\"type\":8,\"startswith\":1},\"level4\":{\"type\":7,\"startswith\":1},\"level7\":{\"type\":7,\"startswith\":1},\"level6\":{\"type\":6,\"startswith\":1},\"level8\":{\"type\":8,\"startswith\":1},\"level1\":{\"type\":6,\"startswith\":1},\"level0\":{\"type\":6,\"startswith\":1},\"level3\":{\"type\":6,\"startswith\":1},\"level2\":{\"type\":6,\"startswith\":1}}\"=\"\" data-spl-bullet-format=\"{}\" style=\"list-style-position: initial; list-style-image: initial;\"><li><p class=\"zw-list zw-paragraph heading0\" data-header=\"0\" data-textformat=\"{\" size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-left=\"0.5in\" data-text-indent=\"-0.25in\" data-margin-bottom=\"6pt\" data-margin-top=\"6pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" data-list-id=\"77757269\" data-list-info=\"{\" id\":\"77757269\",\"l\":0}\"=\"\" style=\"margin: 6pt 0px; line-height: 1.2; direction: ltr;\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\">If a property rents for ₹30,000 per month:</span></p></li><li><p class=\"zw-list zw-paragraph heading0\" data-header=\"0\" data-textformat=\"{\" size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-left=\"0.5in\" data-text-indent=\"-0.25in\" data-margin-bottom=\"6pt\" data-margin-top=\"6pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" data-list-id=\"77757269\" data-list-info=\"{\" id\":\"77757269\",\"l\":0}\"=\"\" style=\"margin: 6pt 0px; line-height: 1.2; direction: ltr;\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\"><a href=\"https://www.lawinsider.com/dictionary/the-annual-rent#:~:text=The%20annual%20rent%20means%20the,beginning%20with%20the%20Initial%20Rent.\" target=\"_blank\" style=\"color: rgb(0, 0, 255); font-weight: bold;\">Annual Rent</a> = ₹30,000 x 12 = ₹360,000</span></p></li><li><p class=\"zw-list zw-paragraph heading0\" data-header=\"0\" data-textformat=\"{\" size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-left=\"0.5in\" data-text-indent=\"-0.25in\" data-margin-bottom=\"6pt\" data-margin-top=\"6pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" data-list-id=\"77757269\" data-list-info=\"{\" id\":\"77757269\",\"l\":0}\"=\"\" style=\"margin: 6pt 0px; line-height: 1.2; direction: ltr;\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\">If bought for ₹4,500,000:</span></p></li><li><p class=\"zw-list zw-paragraph heading0\" data-header=\"0\" data-textformat=\"{\" size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-left=\"0.5in\" data-text-indent=\"-0.25in\" data-margin-bottom=\"6pt\" data-margin-top=\"6pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" data-list-id=\"77757269\" data-list-info=\"{\" id\":\"77757269\",\"l\":0}\"=\"\" style=\"margin: 6pt 0px; line-height: 1.2; direction: ltr;\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\">Gross Yield = (₹360,000 / ₹4,500,000) x 100 = 8%</span></p></li><li><p class=\"zw-list zw-paragraph heading0\" data-header=\"0\" data-textformat=\"{\" size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-left=\"0.5in\" data-text-indent=\"-0.25in\" data-margin-bottom=\"6pt\" data-margin-top=\"6pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" data-list-id=\"77757269\" data-list-info=\"{\" id\":\"77757269\",\"l\":0}\"=\"\" style=\"margin: 6pt 0px; line-height: 1.2; direction: ltr;\"><span style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\">These calculations will give the tenant an idea of whether they are paying a fair price in relation to what the landlord is making from his investment.</span></p></li></ul>",
