gc\":\"rgb(0,=\"\" 0,=\"\" 0)\",\"size\":\"10.50\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" style=\"margin-right: 0px; margin-bottom: 12pt; margin-left: 0px; line-height: 1.2;\"><span style=\"vertical-align: baseline;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Co-living Space</span></p></td><td class=\"zw-td\" col-index=\"1\" data-cell-height=\"auto\" style=\"border-width: 1.06667px; border-color: rgb(0, 0, 0); padding: 7.97px 0px; width: 360px; height: auto; vertical-align: top;\"><p data-header=\"0\" class=\"zw-paragraph heading0\" data-textformat=\"{\" fgc\":\"rgb(0,=\"\" 0,=\"\" 0)\",\"size\":\"10.50\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" style=\"margin-right: 0px; margin-bottom: 12pt; margin-left: 0px; line-height: 1.2;\"><span style=\"vertical-align: baseline;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 10,000 - 20,000</span></p></td></tr></tbody></table><span data-doc-id=\"3105201000000875001\" style=\"font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline;\" data-doc-type=\"writer\">Understanding these trends will help you set a realistic budget when searching for a place.</span><p></p></div>",
