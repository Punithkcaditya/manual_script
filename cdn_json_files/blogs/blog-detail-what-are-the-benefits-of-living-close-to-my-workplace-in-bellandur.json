      "content": "<h2><b><span data-doc-id=\"3105201000000748012\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">Flexibility and Convenience</span><span data-range-char-type=\"start\" data-bookmark-info=\"{\"name\":\"_Tocol6nbd3czqs9\",\"id\":\"toc_247uaz9onqcq\",\"type\":\"bookmark\",\"render_type\":\"inline\",\"geo_transformation\":{\"translation\":{\"x\":false,\"y\":false},\"scaling\":{\"x\":false,\"y\":false},\"rotation\":false}}\" data-bookmark-id=\"toc_247uaz9onqcq\"> </span><span data-range-char-type=\"end\" data-bookmark-info=\"{\"name\":\"_Tocol6nbd3czqs9\",\"id\":\"toc_247uaz9onqcq\",\"type\":\"bookmark\"}\" data-bookmark-id=\"toc_247uaz9onqcq\"> </span></b><br></h2>",
