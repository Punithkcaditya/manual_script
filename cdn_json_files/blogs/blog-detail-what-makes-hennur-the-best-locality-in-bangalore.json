size\":\"10.50\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" style=\"margin-right: 0px; margin-bottom: 12pt; margin-left: 0px; line-height: 1.2;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Majestic</p></td><td class=\"zw-td\" col-index=\"1\" data-cell-height=\"auto\" style=\"border-width: 1.06667px; border-color: rgb(0, 0, 0); padding: 7.97px 0px; width: 141.024px; height: auto; vertical-align: top;\"><p data-header=\"0\" class=\"zw-paragraph heading0\" data-textformat=\"{\" fgc\":\"rgb(0,=\"\" 0,=\"\" 0)\",\"size\":\"10.50\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" style=\"margin-right: 0px; margin-bottom: 12pt; margin-left: 0px; line-height: 1.2;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 17.8 km</p></td></tr><tr data-row-info=\"{\" id\":\"rw-7jx7amtq55x8\",\"type\":\"row\"}\"=\"\"><td class=\"zw-td\" col-index=\"0\" data-cell-height=\"auto\" style=\"border-width: 1.06667px; border-color: rgb(0, 0, 0); padding: 7.97px 0px; width: 494.976px; height: auto; vertical-align: top;\"><p data-header=\"0\" class=\"zw-paragraph heading0\" data-textformat=\"{\" fgc\":\"rgb(0,=\"\" 0,=\"\" 0)\",\"size\":\"10.50\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" style=\"margin-right: 0px; margin-bottom: 12pt; margin-left: 0px; line-height: 1.2;\"><span style=\"vertical-align: baseline;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Manyata Tech Park</span></p></td><td class=\"zw-td\" col-index=\"1\" data-cell-height=\"auto\" style=\"border-width: 1.06667px; border-color: rgb(0, 0, 0); padding: 7.97px 0px; width: 141.024px; height: auto; vertical-align: top;\"><p data-hea