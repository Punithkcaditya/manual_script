r><tr><td><p><span data-doc-id=\"3105201000000948092\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">Fully Furnished Units</span></p></td><td><p><span data-doc-id=\"3105201000000948092\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">Equipped with modern furniture and appliances.</span></p></td></tr><tr><td><p><span data-doc-id=\"3105201000000948092\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">High-Speed Internet</span></p></td><td><p><span data-doc-id=\"3105201000000948092\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">Fast and reliable Wi-Fi for work or leisure.</span></p></td></tr><tr><td><p><span data-doc-id=\"3105201000000948092\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">24/7 Security</span></p></td><td><p><span data-doc-id=\"3105201000000948092\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">CCTV cameras and on-site security personnel.</span></p></td></tr><tr><td><p><span data-doc-id=\"3105201000000948092\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">Pet-Friendly</span></p></td><td><p><span data-doc-id=\"3105201000000948092\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">Kots properties welcome pets (conditions apply).</span></p></td></tr><tr><td><p><span data-doc-id=\"3105201000000948092\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">Regular Maintenance</span></p></td><td><p><span data-doc-id=\"3105201000000948092\" style=\"vertical-align: baseline;\" data-doc-type=\"writer\">Dedicated team to handle property upkeep</span></p></td></tr></tbody></table><p data-header=\"0\" class=\"zw-paragraph heading0\" data-textformat=\"{\" fgc\":\"rgb(0,=\"\" 0,=\"\" 0)\",\"size\":\"12.00\",\"type\":\"text\"}\"=\"\" data-margin-bottom=\"12pt\" data-margin-top=\"12pt\" data-hd-info=\"0\" data_styles=\"{\" data-line-height=\"1.2\" data-doc-id=\"3105201000000948092\" style=\"margin: 12pt 0px; line-height: 1.2; direction: ltr;\" data-